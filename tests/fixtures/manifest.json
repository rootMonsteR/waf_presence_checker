{
  "schema_version": 2,
  "description": "Ground-truth fixtures for edgeprint. Seed of the benchmark corpus; the schema is shared with lab- and CNAME-labelled records so they slot in without migration.",
  "label_sources": {
    "synthetic": "Hand-built from publicly documented vendor response patterns. Lowest confidence tier; to be replaced by lab captures.",
    "lab": "Captured from a WAF we stood up ourselves. Label is known, not inferred.",
    "cname": "Live host labelled by DNS CNAME delegation.",
    "cidr": "Live host labelled by vendor-published IP range."
  },
  "layers": {
    "cdn": "Content delivery / caching edge. Presence says nothing about filtering.",
    "waf": "Request filtering layer.",
    "bot": "Bot management / anti-automation layer."
  },
  "fixtures": [
