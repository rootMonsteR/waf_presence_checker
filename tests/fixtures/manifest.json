      "label_source": "synthetic",
      "expect_layers": [
        "cdn"
      ],
      "expect_vendor": "Cloudflare (edge firewall/CDN)",
      "expect_exit": 3,
      "notes": "cf-ray proves the CDN edge only; Cloudflare's WAF is optional and leaves separate signals."
    },
